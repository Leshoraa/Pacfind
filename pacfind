#!/usr/bin/env python3
"""
Pacfind - Minimalist, clean, and fast Arch Linux & AUR package search.
Combines Official Repositories (pacman) and AUR search into a clean,
organized layout with zero emojis.
"""

import sys
import os
import shutil
import argparse
import subprocess
import urllib.request
import urllib.parse
import urllib.error
import json
from concurrent.futures import ThreadPoolExecutor

VERSION = "1.0.0"

# ANSI Colors
def get_colors():
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return {k: "" for k in [
            "reset", "bold", "dim", "cyan", "magenta", "green",
            "yellow", "white", "red", "blue"
        ]}
    return {
        "reset": "\033[0m",
        "bold": "\033[1m",
        "dim": "\033[2m",
        "cyan": "\033[1;36m",
        "magenta": "\033[1;35m",
        "green": "\033[1;32m",
        "yellow": "\033[1;33m",
        "white": "\033[1;37m",
        "red": "\033[1;31m",
        "blue": "\033[1;34m",
    }

C = get_colors()

def get_installed_packages():
    """Retrieve set of currently installed packages on the system."""
    try:
        proc = subprocess.run(
            ["pacman", "-Qq"],
            capture_output=True,
            text=True,
            check=False
        )
        if proc.returncode == 0:
            return set(proc.stdout.strip().splitlines())
    except Exception:
        pass
    return set()

def search_official(query):
    """Search official Arch repositories using pacman -Ss."""
    results = []
    try:
        proc = subprocess.run(
            ["pacman", "-Ss", query],
            capture_output=True,
            text=True,
            check=False,
            env=dict(os.environ, LANG="C")
        )
        lines = proc.stdout.splitlines()
        current_pkg = None

        for line in lines:
            if not line:
                continue
            if line.startswith("    ") or line.startswith("\t"):
                if current_pkg:
                    desc = line.strip()
                    current_pkg["description"] = desc
                    results.append(current_pkg)
                    current_pkg = None
            else:
                # Format: repo/name version [groups] [installed]
                parts = line.strip().split()
                if not parts:
                    continue
                repo_name = parts[0]
                if "/" in repo_name:
                    repo, name = repo_name.split("/", 1)
                else:
                    repo, name = "official", repo_name
                
                version = parts[1] if len(parts) > 1 else ""
                is_installed = any("installed" in p for p in parts[2:])
                
                current_pkg = {
                    "repo": repo,
                    "name": name,
                    "version": version,
                    "is_installed": is_installed,
                    "description": ""
                }
        if current_pkg:
            results.append(current_pkg)
    except Exception as e:
        return results, str(e)
    
    # Sort: exact match first, then starts-with, then alphabetical
    q_lower = query.lower()
    def sort_key(item):
        name = item["name"].lower()
        if name == q_lower:
            return (0, name)
        if name.startswith(q_lower):
            return (1, name)
        return (2, name)

    results.sort(key=sort_key)
    return results, None

def search_aur(query, installed_set):
    """Search AUR using Arch Linux RPC v5 API."""
    results = []
    error_msg = None
    try:
        encoded_query = urllib.parse.quote(query)
        url = f"https://aur.archlinux.org/rpc/v5/search/{encoded_query}"
        req = urllib.request.Request(
            url,
            headers={"User-Agent": f"pacfind/{VERSION} (Arch Linux package search)"}
        )
        with urllib.request.urlopen(req, timeout=7) as response:
            if response.status == 200:
                data = json.loads(response.read().decode("utf-8"))
                raw_results = data.get("results", [])
                for item in raw_results:
                    name = item.get("Name", "")
                    results.append({
                        "repo": "aur",
                        "name": name,
                        "version": item.get("Version", ""),
                        "description": item.get("Description") or "No description provided",
                        "votes": item.get("NumVotes", 0),
                        "popularity": item.get("Popularity", 0.0),
                        "is_installed": name in installed_set,
                        "out_of_date": item.get("OutOfDate") is not None
                    })
            else:
                error_msg = f"HTTP {response.status}"
    except urllib.error.URLError:
        # Fallback to yay if offline or API blocked
        try:
            proc = subprocess.run(
                ["yay", "-Ss", "--aur", query],
                capture_output=True,
                text=True,
                check=False
            )
            lines = proc.stdout.splitlines()
            cur = None
            for line in lines:
                if line.startswith("    "):
                    if cur:
                        cur["description"] = line.strip()
                        results.append(cur)
                        cur = None
                elif line.startswith("aur/"):
                    parts = line.split()
                    name = parts[0].replace("aur/", "")
                    ver = parts[1] if len(parts) > 1 else ""
                    cur = {
                        "repo": "aur",
                        "name": name,
                        "version": ver,
                        "description": "",
                        "votes": 0,
                        "popularity": 0.0,
                        "is_installed": name in installed_set,
                        "out_of_date": False
                    }
            if cur:
                results.append(cur)
        except Exception:
            error_msg = "Network connection failed & yay fallback unavailable"
    except Exception as e:
        error_msg = str(e)

    # Sort AUR: exact match first, then popularity descending
    q_lower = query.lower()
    def aur_sort_key(item):
        name = item["name"].lower()
        if name == q_lower:
            return (0, -item["popularity"], -item["votes"])
        if name.startswith(q_lower):
            return (1, -item["popularity"], -item["votes"])
        return (2, -item["popularity"], -item["votes"])

    results.sort(key=aur_sort_key)
    return results, error_msg

def print_divider(width=None):
    term_width = shutil.get_terminal_size((80, 20)).columns
    actual_width = min(term_width, width or 80)
    print(f"{C['dim']}{'─' * actual_width}{C['reset']}")

def render_results(query, official_pkgs, aur_pkgs, show_official, show_aur, limit=None, aur_err=None):
    width = min(shutil.get_terminal_size((80, 20)).columns, 80)

    # 1. Official Repositories
    if show_official:
        print(f"{C['bold']}{C['cyan']}OFFICIAL REPOSITORIES{C['reset']}")
        print_divider(width)

        if not official_pkgs:
            print(f"  {C['dim']}No packages found in official repositories.{C['reset']}")
        else:
            display_list = official_pkgs[:limit] if limit else official_pkgs
            for pkg in display_list:
                status = f" {C['green']}[installed]{C['reset']}" if pkg["is_installed"] else ""
                print(f"  {C['blue']}{pkg['repo']}{C['reset']}/{C['white']}{pkg['name']}{C['reset']} {C['green']}{pkg['version']}{C['reset']}{status}")
                if pkg["description"]:
                    print(f"    {C['dim']}{pkg['description']}{C['reset']}")
            
            if limit and len(official_pkgs) > limit:
                print(f"  {C['dim']}... ({len(official_pkgs) - limit} more packages not shown, use --limit or omit to see all){C['reset']}")
        print()

    # 2. Arch User Repository (AUR)
    if show_aur:
        print(f"{C['bold']}{C['magenta']}ARCH USER REPOSITORY (AUR){C['reset']}")
        print_divider(width)

        if aur_err:
            print(f"  {C['yellow']}Notice: {aur_err}{C['reset']}")
        elif not aur_pkgs:
            print(f"  {C['dim']}No packages found in AUR.{C['reset']}")
        else:
            display_list = aur_pkgs[:limit] if limit else aur_pkgs
            for pkg in display_list:
                status = f" {C['green']}[installed]{C['reset']}" if pkg["is_installed"] else ""
                stats = f"{C['dim']}(+{pkg['votes']}, {pkg['popularity']:.1f}){C['reset']}"
                ood = f" {C['red']}[out-of-date]{C['reset']}" if pkg.get("out_of_date") else ""
                print(f"  {C['magenta']}aur{C['reset']}/{C['white']}{pkg['name']}{C['reset']} {C['green']}{pkg['version']}{C['reset']} {stats}{ood}{status}")
                if pkg["description"]:
                    print(f"    {C['dim']}{pkg['description']}{C['reset']}")

            if limit and len(aur_pkgs) > limit:
                print(f"  {C['dim']}... ({len(aur_pkgs) - limit} more packages not shown, use --limit or omit to see all){C['reset']}")
        print()

    # 3. Summary Footer
    print_divider(width)
    total_official = len(official_pkgs)
    total_aur = len(aur_pkgs)

    if show_official and show_aur:
        print(f"{C['bold']}Summary:{C['reset']} {total_official} found in official repositories, {total_aur} found in AUR")
    elif show_official:
        print(f"{C['bold']}Summary:{C['reset']} {total_official} found in official repositories")
    elif show_aur:
        print(f"{C['bold']}Summary:{C['reset']} {total_aur} found in AUR")
    print_divider(width)

def run_interactive(official_pkgs, aur_pkgs):
    """Interactive mode using fzf to select and install package."""
    items = []
    for p in official_pkgs:
        st = " [installed]" if p["is_installed"] else ""
        items.append(f"[official] {p['repo']}/{p['name']} ({p['version']}){st} - {p['description']}")
    for p in aur_pkgs:
        st = " [installed]" if p["is_installed"] else ""
        items.append(f"[aur]      aur/{p['name']} ({p['version']}){st} - {p['description']}")

    if not items:
        print(f"{C['yellow']}No packages found to select.{C['reset']}")
        return

    try:
        fzf = subprocess.Popen(
            [
                "fzf",
                "--ansi",
                "--header=Select a package to install (ENTER: Install, ESC: Cancel)",
                "--prompt=pacfind > "
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        selected, _ = fzf.communicate(input="\n".join(items))
        if fzf.returncode == 0 and selected.strip():
            sel = selected.strip()
            parts = sel.split()
            if len(parts) >= 2:
                target = parts[1].split("/")[-1]
                is_aur = parts[0] == "[aur]"
                cmd = ["yay", "-S", target] if is_aur else ["sudo", "pacman", "-S", target]
                print(f"\n{C['bold']}Executing: {' '.join(cmd)}{C['reset']}\n")
                subprocess.run(cmd)
    except FileNotFoundError:
        print(f"{C['red']}Error: 'fzf' is not installed for interactive mode.{C['reset']}")

def main():
    parser = argparse.ArgumentParser(
        prog="pacfind",
        description="Fast and clean Arch Linux & AUR package search tool (no emojis, organized output).",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("query", nargs="+", help="Package search term or keyword")
    parser.add_argument("-o", "--official", action="store_true", help="Search official repositories only")
    parser.add_argument("-a", "--aur", action="store_true", help="Search AUR only")
    parser.add_argument("-l", "--limit", type=int, default=None, help="Limit number of results per repository")
    parser.add_argument("-i", "--interactive", action="store_true", help="Interactive selection & installation via fzf")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    args = parser.parse_args()
    query = " ".join(args.query).strip()

    if not query:
        parser.print_help()
        sys.exit(1)

    show_official = True
    show_aur = True
    if args.official and not args.aur:
        show_aur = False
    elif args.aur and not args.official:
        show_official = False

    installed_set = get_installed_packages()

    official_pkgs = []
    aur_pkgs = []
    aur_err = None

    # Run searches concurrently
    with ThreadPoolExecutor(max_workers=2) as executor:
        future_off = executor.submit(search_official, query) if show_official else None
        future_aur = executor.submit(search_aur, query, installed_set) if show_aur else None

        if future_off:
            official_pkgs, _ = future_off.result()
        if future_aur:
            aur_pkgs, aur_err = future_aur.result()

    if args.interactive:
        run_interactive(official_pkgs, aur_pkgs)
    else:
        render_results(
            query=query,
            official_pkgs=official_pkgs,
            aur_pkgs=aur_pkgs,
            show_official=show_official,
            show_aur=show_aur,
            limit=args.limit,
            aur_err=aur_err
        )

if __name__ == "__main__":
    main()
